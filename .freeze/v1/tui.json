{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "osien-dope",
  "leader_timeout": 1000,
  "scroll_speed": 5,
  "diff_style": "auto",
  "cursor": {
    "style": "block",
    "blinking": true
  },
  "mouse": true,
  "scroll_acceleration": {
    "enabled": false
  },
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 0.4,
    "sound_pack": "opencode.default"
  },
  "keybinds": {
    "leader": "ctrl+x",
    "command_list": "<leader>p",
    "app_exit": "ctrl+c,ctrl+d,<leader>q",
    "app_debug": "none",
    "app_console": "none",
    "app_heap_snapshot": "none",
    "docs_open": "none",
    "help_show": "none",
    "editor_open": "<leader>e",
    "theme_list": "<leader>t",
    "theme_switch_mode": "none",
    "theme_mode_lock": "none",
    "sidebar_toggle": "<leader>b",
    "scrollbar_toggle": "none",
    "status_view": "<leader>s",
    "session_new": "<leader>n",
    "session_list": "ctrl+p",
    "session_timeline": "<leader>g",
    "session_compact": "<leader>c",
    "session_interrupt": "escape",
    "session_fork": "<leader>f",
    "session_share": "none",
    "session_unshare": "none",
    "session_copy": "none",
    "session_move": "none",
    "session_toggle_timestamps": "none",
    "session_toggle_generic_tool_output": "none",
    "model_list": "<leader>m",
    "model_cycle_recent": "f2",
    "model_cycle_recent_reverse": "shift+f2",
    "model_provider_list": "ctrl+a",
    "model_favorite_toggle": "ctrl+f",
    "model_cycle_favorite": "none",
    "model_cycle_favorite_reverse": "none",
    "agent_list": "<leader>a",
    "agent_cycle": "tab",
    "agent_cycle_reverse": "shift+tab",
    "variant_cycle": "ctrl+t",
    "variant_list": "none",
    "mcp_list": "none",
    "provider_connect": "none",
    "console_org_switch": "none",
    "messages_copy": "<leader>y",
    "messages_undo": "<leader>u",
    "messages_redo": "<leader>r",
    "messages_toggle_conceal": "<leader>h",
    "messages_page_up": "pageup",
    "messages_page_down": "pagedown",
    "messages_first": "home",
    "messages_last": "end",
    "messages_next": "none",
    "messages_previous": "none",
    "messages_last_user": "none",
    "tool_details": "none",
    "display_thinking": "none",
    "input_submit": "return",
    "input_newline": "shift+return,ctrl+return,alt+return,ctrl+j",
    "input_clear": "ctrl+c",
    "session_rename": "ctrl+r",
    "session_delete": "ctrl+d"
  }
}