    "markdownImage": { "dark": "pewter", "light": "pewter" },
    "markdownImageText": { "dark": "pewter", "light": "pewter" },
    "markdownCodeBlock": { "dark": "snow", "light": "void" },
    "syntaxComment": { "dark": "dim", "light": "dim" },
    "syntaxKeyword": { "dark": "gold", "light": "copper" },
    "syntaxFunction": { "dark": "steel", "light": "slate" },
    "syntaxVariable": { "dark": "snow", "light": "void" },
    "syntaxString": { "dark": "sage", "light": "sage" },
    "syntaxNumber": { "dark": "champagne", "light": "copper" },
