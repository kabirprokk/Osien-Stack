{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "void": "#101014",
    "panel": "#16161d",
    "elem": "#1f1f29",
    "edge": "#2e2e3c",
    "edgeHot": "#c9a86a",
    "snow": "#e8e6e1",
    "dim": "#8f8f9a",
    "gold": "#d4af7a",
    "champagne": "#e6cf9e",
    "steel": "#8fa3b8",
    "copper": "#b87347",
    "slate": "#7d8ca3",
    "sage": "#7d9b76",
    "bronze": "#c99b4a",
    "brick": "#b05c5c",
    "pewter": "#9a8fb5"
  },
  "theme": {
    "primary": { "dark": "gold", "light": "copper" },
    "secondary": { "dark": "steel", "light": "slate" },
    "accent": { "dark": "champagne", "light": "copper" },
    "error": { "dark": "brick", "light": "brick" },
