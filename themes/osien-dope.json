    "borderSubtle": { "dark": "edge", "light": "edge" },
    "diffAdded": { "dark": "sage", "light": "sage" },
    "diffRemoved": { "dark": "brick", "light": "brick" },
    "diffContext": { "dark": "dim", "light": "dim" },
    "diffHunkHeader": { "dark": "pewter", "light": "pewter" },
    "diffHighlightAdded": { "dark": "sage", "light": "sage" },
    "diffHighlightRemoved": { "dark": "brick", "light": "brick" },
